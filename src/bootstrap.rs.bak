//! RPC Bootstrap for CLMM Pool State
//!
//! Fetches initial sqrt_price, liquidity, and tick data for CLMM pools via RPC
//! at startup. This eliminates the stale pools.json problem while maintaining
//! the static pool discovery metadata.
//!
//! Flow:
//! 1. pools.json provides pool addresses and static metadata
//! 2. Geyser subscription is established first (for slot ordering)
//! 3. RPC bootstrap fetches current state (only accepted if newer than Geyser slot)
//! 4. Geyser continues to provide real-time updates
//!
//! ## Race Condition Mitigation
//!
//! Bootstrap and Geyser run concurrently. To prevent stale RPC data from overwriting
//! fresher Geyser data:
//! - We use `get_multiple_accounts_with_context` to get the actual slot for each batch
//! - PSM's slot ordering rejects updates with slot < last_confirmed_slot
//! - Failed pools are tracked and reported for monitoring
//! - Bootstrap status is propagated back to the caller for health checks

use crate::pool_discovery::{parse_meteora_damm, parse_raydium_clmm};
use crate::pool_state::PoolStateManager;
use crate::shredstream::programs::DexType;
use anyhow::Result;
use solana_client::nonblocking::rpc_client::RpcClient;
use solana_client::rpc_config::RpcAccountInfoConfig;
use solana_client::rpc_response::UiAccountEncoding;
use solana_commitment_config::CommitmentConfig;
use solana_sdk::pubkey::Pubkey;
use std::collections::HashSet;
use std::sync::Arc;
use std::time::Instant;
use tracing::{debug, error, info, warn};

/// Maximum accounts per getMultipleAccounts call (Solana RPC limit is 100)
const BATCH_SIZE: usize = 100;

/// Minimum valid slot (reject slot 0 which can indicate genesis/restart edge cases)
const MIN_VALID_SLOT: u64 = 1;

/// Bootstrap result statistics
#[derive(Debug, Default, Clone)]
pub struct BootstrapStats {
    pub pools_attempted: usize,
    pub pools_updated: usize,
    pub pools_skipped_older_slot: usize,
    pub pools_failed_parse: usize,
    pub pools_no_data: usize,
    pub pools_rpc_error: usize,
    pub rpc_calls: usize,
    pub duration_ms: u64,
    /// Pools that failed bootstrap (for monitoring/retry)
    pub failed_pools: Vec<Pubkey>,
    /// Minimum slot seen across all RPC batches
    pub rpc_slot_min: Option<u64>,
    /// Maximum slot seen across all RPC batches
    pub rpc_slot_max: Option<u64>,
    /// Whether bootstrap completed successfully (all pools attempted)
    pub completed: bool,
    /// Per-DEX parse failure counts for debugging protocol changes
    pub parse_failures_by_dex: std::collections::HashMap<String, usize>,
    /// Per-DEX discriminator mismatch counts
    pub discriminator_mismatches_by_dex: std::collections::HashMap<String, usize>,
    /// Slot variance across batches (for consistency checking)
    pub slot_variance: u64,
    /// Pools that were skipped due to Geyser already having data
    pub pools_skipped_geyser_confirmed: usize,
}

/// Minimum success rate for healthy bootstrap (95%)
const BOOTSTRAP_HEALTH_THRESHOLD: f64 = 0.95;

/// Maximum acceptable slot variance across batches before warning
const MAX_SLOT_VARIANCE: u64 = 10;

impl BootstrapStats {
    /// Returns true if bootstrap was successful (>95% pools updated or geyser-confirmed, no critical errors)
    pub fn is_healthy(&self) -> bool {
        if self.pools_attempted == 0 {
            return true; // No pools to bootstrap is fine
        }
        // Count both updated and geyser-confirmed as success
        let successes = self.pools_updated + self.pools_skipped_geyser_confirmed + self.pools_skipped_older_slot;
        let success_rate = successes as f64 / self.pools_attempted as f64;
        self.completed && success_rate >= BOOTSTRAP_HEALTH_THRESHOLD
    }
    
    /// Returns a summary string for logging
    pub fn summary(&self) -> String {
        let slot_range = match (self.rpc_slot_min, self.rpc_slot_max) {
            (Some(min), Some(max)) if min == max => format!("{}", min),
            (Some(min), Some(max)) => format!("{}-{} (Δ{})", min, max, max - min),
            _ => "none".to_string(),
        };
        format!(
            "updated={}/{} geyser_confirmed={} skipped_older={} failed_parse={} no_data={} rpc_err={} rpc_calls={} slots={} ms={}",
            self.pools_updated,
            self.pools_attempted,
            self.pools_skipped_geyser_confirmed,
            self.pools_skipped_older_slot,
            self.pools_failed_parse,
            self.pools_no_data,
            self.pools_rpc_error,
            self.rpc_calls,
            slot_range,
            self.duration_ms
        )
    }
}

/// Bootstrap CLMM pool state from RPC
///
/// Fetches current sqrt_price, liquidity, and tick data for all CLMM pools
/// in the PoolStateManager. Only updates pools where RPC slot > existing slot.
///
/// # Arguments
/// * `rpc_client` - RPC client for getMultipleAccounts calls
/// * `psm` - PoolStateManager with pre-registered pools
/// * `min_slot` - Minimum slot to accept (use Geyser's current slot for race protection)
///
/// # Returns
/// Bootstrap statistics with detailed failure tracking
pub async fn bootstrap_clmm_pools(
    rpc_client: &RpcClient,
    psm: &Arc<PoolStateManager>,
    min_slot: u64,
) -> Result<BootstrapStats> {
    let start = Instant::now();
    let mut stats = BootstrapStats::default();

    // Get all CLMM pool addresses with dex types in single lock acquisition
    // This prevents race where pool is added/removed between lookups
    let clmm_pools: Vec<(Pubkey, DexType)> = psm.all_clmm_pools_with_dex();

    stats.pools_attempted = clmm_pools.len();

    if clmm_pools.is_empty() {
        info!("No CLMM pools to bootstrap");
        stats.duration_ms = start.elapsed().as_millis() as u64;
        stats.completed = true;
        return Ok(stats);
    }

    info!(
        "Bootstrapping {} CLMM pools via RPC (min_slot={})",
        clmm_pools.len(),
        min_slot
    );

    // Get current slot for reference - if this fails, RPC is down
    let reference_slot = match rpc_client.get_slot().await {
        Ok(slot) => {
            if slot < MIN_VALID_SLOT {
                warn!("RPC returned invalid slot {} - may be genesis/restart edge case", slot);
            }
            slot
        }
        Err(e) => {
            error!("Failed to get current slot from RPC: {} - aborting bootstrap", e);
            // Mark all pools as failed
            stats.failed_pools = clmm_pools.iter().map(|(addr, _)| *addr).collect();
            stats.pools_rpc_error = clmm_pools.len();
            return Err(anyhow::anyhow!("RPC unavailable: {}", e));
        }
    };

    info!("Bootstrap reference slot: {} (min accepted: {})", reference_slot, min_slot.max(MIN_VALID_SLOT));

    // Track which pools succeeded for PSM notification
    let mut bootstrapped_pools: HashSet<Pubkey> = HashSet::new();

    // Process in batches to respect RPC limits
    for batch in clmm_pools.chunks(BATCH_SIZE) {
        let addresses: Vec<Pubkey> = batch.iter().map(|(addr, _)| *addr).collect();
        let dex_types: Vec<DexType> = batch.iter().map(|(_, dex)| *dex).collect();

        stats.rpc_calls += 1;

        // Use get_multiple_accounts_with_context to get actual slot from RPC response
        // This prevents using stale reference_slot when RPC is lagging
        // Use confirmed commitment to avoid reading from rolled-back forks
        let config = RpcAccountInfoConfig {
            encoding: Some(UiAccountEncoding::Base64),
            commitment: Some(CommitmentConfig::confirmed()),
            ..Default::default()
        };

        let response = match rpc_client
            .get_multiple_accounts_with_config(&addresses, config)
            .await
        {
            Ok(response) => response,
            Err(e) => {
                warn!("RPC batch fetch failed for {} accounts: {}", addresses.len(), e);
                // Track failed pools
                for addr in &addresses {
                    stats.failed_pools.push(*addr);
                }
                stats.pools_rpc_error += addresses.len();
                continue;
            }
        };

        // Extract actual slot from RPC context - this is the ground truth slot
        let batch_slot = response.context.slot;
        
        // Track slot range across all batches
        stats.rpc_slot_min = Some(stats.rpc_slot_min.map_or(batch_slot, |min| min.min(batch_slot)));
        stats.rpc_slot_max = Some(stats.rpc_slot_max.map_or(batch_slot, |max| max.max(batch_slot)));

        // Validate slot is reasonable
        if batch_slot < MIN_VALID_SLOT {
            warn!(
                "RPC context slot {} is below minimum {} - skipping batch",
                batch_slot, MIN_VALID_SLOT
            );
            for addr in &addresses {
                stats.failed_pools.push(*addr);
            }
            stats.pools_rpc_error += addresses.len();
            continue;
        }

        // Check if RPC slot is too old compared to min_slot (Geyser's slot)
        // Allow some tolerance for normal slot variance (5 slots)
        const SLOT_LAG_TOLERANCE: u64 = 5;
        if min_slot > 0 && batch_slot + SLOT_LAG_TOLERANCE < min_slot {
            warn!(
                "RPC slot {} is significantly behind Geyser min_slot {} - data may be stale",
                batch_slot, min_slot
            );
            // Still process but log warning - PSM slot ordering will reject if truly stale
        }

        // Process each account
        for (i, maybe_account) in response.value.into_iter().enumerate() {
            let address = addresses[i];
            let dex = dex_types[i];

            let Some(account) = maybe_account else {
                warn!(pool = %address, dex = ?dex, "Pool account not found on-chain during bootstrap");
                stats.pools_no_data += 1;
                stats.failed_pools.push(address);
                continue;
            };

            // Account data is already decoded by the RPC client
            let data = &account.data;

            // Parse based on DEX type
            let dex_name = format!("{:?}", dex);
            let parsed = match dex {
                DexType::RaydiumClmm | DexType::PancakeSwapClmm => {
                    parse_raydium_clmm(address, data).map(ParsedClmmState::from)
                }
                DexType::MeteoraDamm => {
                    parse_meteora_damm(address, data).map(ParsedClmmState::from)
                }
                DexType::OrcaWhirlpool => {
                    parse_whirlpool_state(address, data, &mut stats)
                }
                DexType::MeteoraDlmm => {
                    parse_dlmm_state(address, data, &mut stats)
                }
                _ => {
                    debug!(pool = %address, dex = ?dex, "Unsupported DEX type for bootstrap");
                    None
                }
            };

            let Some(pool_data) = parsed else {
                warn!(pool = %address, dex = ?dex, data_len = data.len(), "Failed to parse pool data during bootstrap");
                stats.pools_failed_parse += 1;
                *stats.parse_failures_by_dex.entry(dex_name).or_insert(0) += 1;
                stats.failed_pools.push(address);
                continue;
            };

            // Try to update PSM - this uses strict slot comparison and won't overwrite Geyser data
            let updated = psm.update_clmm_state_from_bootstrap(
                &address,
                pool_data.sqrt_price,
                pool_data.current_tick_or_bin,
                pool_data.spacing,
                pool_data.active_liquidity,
                batch_slot,
            );
            
            if updated {
                bootstrapped_pools.insert(address);
                stats.pools_updated += 1;
                
                debug!(
                    pool = %address,
                    sqrt_price = ?pool_data.sqrt_price,
                    tick = pool_data.current_tick_or_bin,
                    liquidity = ?pool_data.active_liquidity,
                    slot = batch_slot,
                    "Bootstrapped CLMM pool state"
                );
            } else {
                // Pool was not updated - either Geyser has newer/same slot data or pool is geyser-confirmed
                let existing_slot = psm.get_pool_last_slot(&address).unwrap_or(0);
                if existing_slot >= batch_slot {
                    debug!(
                        pool = %address,
                        existing_slot = existing_slot,
                        rpc_slot = batch_slot,
                        "Skipping bootstrap - Geyser already has data at same or newer slot"
                    );
                    stats.pools_skipped_geyser_confirmed += 1;
                } else {
                    stats.pools_skipped_older_slot += 1;
                }
            }
        }
    }

    // Calculate slot variance
    if let (Some(min_slot), Some(max_slot)) = (stats.rpc_slot_min, stats.rpc_slot_max) {
        stats.slot_variance = max_slot.saturating_sub(min_slot);
        if stats.slot_variance > MAX_SLOT_VARIANCE {
            warn!(
                "High slot variance across RPC batches: {} slots (min={}, max={}) - data may be inconsistent",
                stats.slot_variance, min_slot, max_slot
            );
        }
    }

    // Mark failed pools in PSM so they're excluded from arb until Geyser confirms
    for pool_addr in &stats.failed_pools {
        psm.mark_pool_bootstrap_failed(pool_addr);
    }

    stats.duration_ms = start.elapsed().as_millis() as u64;
    stats.completed = true;

    // Log summary with appropriate level based on success
    if stats.is_healthy() {
        info!(
            "Bootstrap complete: {}",
            stats.summary()
        );
    } else {
        warn!(
            "Bootstrap completed with issues: {}",
            stats.summary()
        );
        if !stats.failed_pools.is_empty() {
            let failed_sample: Vec<String> = stats.failed_pools.iter()
                .take(5)
                .map(|p| p.to_string()[..8].to_string())
                .collect();
            warn!(
                "Failed pools sample: {:?}{}",
                failed_sample,
                if stats.failed_pools.len() > 5 { format!(" (+{} more)", stats.failed_pools.len() - 5) } else { String::new() }
            );
        }
        // Log per-DEX failures for protocol upgrade detection
        if !stats.parse_failures_by_dex.is_empty() {
            warn!("Parse failures by DEX: {:?}", stats.parse_failures_by_dex);
        }
        if !stats.discriminator_mismatches_by_dex.is_empty() {
            warn!("Discriminator mismatches by DEX: {:?}", stats.discriminator_mismatches_by_dex);
        }
    }

    // Only notify PSM about bootstrap completion if healthy
    // Unhealthy bootstrap shouldn't mark pools as "bootstrapped" when they failed
    if stats.is_healthy() {
        psm.on_bootstrap_complete(bootstrapped_pools);
    } else {
        warn!("Skipping on_bootstrap_complete due to unhealthy bootstrap - {} pools not marked as bootstrapped", 
              bootstrapped_pools.len());
    }

    Ok(stats)
}

/// Parse Orca Whirlpool state for sqrt_price/liquidity
fn parse_whirlpool_state(_address: Pubkey, data: &[u8], stats: &mut BootstrapStats) -> Option<ParsedClmmState> {
    // Whirlpool layout offsets (from whirlpool SDK)
    // Discriminator: 8 bytes
    // whirlpools_config: 32 bytes @ 8
    // whirlpool_bump: 1 byte @ 40 (array of bumps)
    // tick_spacing: u16 @ 41
    // tick_spacing_seed: 2 bytes @ 43
    // fee_rate: u16 @ 45
    // protocol_fee_rate: u16 @ 47
    // liquidity: u128 @ 49
    // sqrt_price: u128 @ 65
    // tick_current_index: i32 @ 81

    const MIN_SIZE: usize = 653;
    const TICK_SPACING: usize = 41;
    const LIQUIDITY: usize = 49;
    const SQRT_PRICE: usize = 65;
    const TICK_CURRENT: usize = 81;

    if data.len() < MIN_SIZE {
        return None;
    }

    // Whirlpool discriminator
    let expected_disc: [u8; 8] = [63, 149, 209, 12, 225, 128, 99, 9];
    if &data[0..8] != &expected_disc {
        warn!(
            pool = %_address,
            expected = ?expected_disc,
            actual = ?&data[0..8],
            "Whirlpool discriminator mismatch - possible protocol upgrade"
        );
        *stats.discriminator_mismatches_by_dex.entry("OrcaWhirlpool".to_string()).or_insert(0) += 1;
        return None;
    }

    let tick_spacing = u16::from_le_bytes([data[TICK_SPACING], data[TICK_SPACING + 1]]);

    let liquidity =
        u128::from_le_bytes(data[LIQUIDITY..LIQUIDITY + 16].try_into().ok()?);

    let sqrt_price =
        u128::from_le_bytes(data[SQRT_PRICE..SQRT_PRICE + 16].try_into().ok()?);

    let tick_current =
        i32::from_le_bytes(data[TICK_CURRENT..TICK_CURRENT + 4].try_into().ok()?);

    Some(ParsedClmmState {
        sqrt_price: Some(sqrt_price),
        active_liquidity: Some(liquidity),
        current_tick_or_bin: tick_current,
        spacing: tick_spacing,
    })
}

/// Parse Meteora DLMM state for active_bin_id
fn parse_dlmm_state(_address: Pubkey, data: &[u8], stats: &mut BootstrapStats) -> Option<ParsedClmmState> {
    // DLMM layout offsets
    // Discriminator: 8 bytes
    // parameters: LbPairParameters @ 8
    //   - Parameters include bin_step at offset 0 (u16)
    // v_parameters: VariableParameters @ 40
    //   - active_id: i32 @ 72 (40 + 32)

    const MIN_SIZE: usize = 904;
    const BIN_STEP: usize = 8;
    const ACTIVE_ID: usize = 72;

    if data.len() < MIN_SIZE {
        return None;
    }

    // DLMM LbPair discriminator
    let expected_disc: [u8; 8] = [33, 11, 49, 98, 181, 101, 177, 13];
    if &data[0..8] != &expected_disc {
        warn!(
            pool = %_address,
            expected = ?expected_disc,
            actual = ?&data[0..8],
            "DLMM discriminator mismatch - possible protocol upgrade"
        );
        *stats.discriminator_mismatches_by_dex.entry("MeteoraDlmm".to_string()).or_insert(0) += 1;
        return None;
    }

    let bin_step = u16::from_le_bytes([data[BIN_STEP], data[BIN_STEP + 1]]);
    let active_id = i32::from_le_bytes(data[ACTIVE_ID..ACTIVE_ID + 4].try_into().ok()?);

    // DLMM doesn't use sqrt_price - it uses bin-based pricing
    Some(ParsedClmmState {
        sqrt_price: None,
        active_liquidity: None,
        current_tick_or_bin: active_id,
        spacing: bin_step,
    })
}

/// Retry bootstrap for specific failed pools
///
/// Called after initial bootstrap to recover pools that failed due to transient errors.
/// Uses the same slot comparison logic as the main bootstrap.
pub async fn retry_failed_bootstrap_pools(
    rpc_client: &RpcClient,
    psm: &Arc<PoolStateManager>,
    failed_pools: &[Pubkey],
    min_slot: u64,
) -> Result<BootstrapStats> {
    let start = Instant::now();
    let mut stats = BootstrapStats::default();
    
    if failed_pools.is_empty() {
        stats.completed = true;
        return Ok(stats);
    }
    
    stats.pools_attempted = failed_pools.len();
    
    // Get DEX types for the failed pools
    let pools_with_dex: Vec<(Pubkey, DexType)> = {
        let pool_dexes: Vec<_> = failed_pools.iter()
            .filter_map(|addr| {
                psm.get_pool_dex(addr).map(|dex| (*addr, dex))
            })
            .collect();
        pool_dexes
    };
    
    info!("Retrying bootstrap for {} failed pools (min_slot={})", pools_with_dex.len(), min_slot);
    
    // Process in batches
    for batch in pools_with_dex.chunks(BATCH_SIZE) {
        let addresses: Vec<Pubkey> = batch.iter().map(|(addr, _)| *addr).collect();
        let dex_types: Vec<DexType> = batch.iter().map(|(_, dex)| *dex).collect();
        
        stats.rpc_calls += 1;
        
        let config = RpcAccountInfoConfig {
            encoding: Some(UiAccountEncoding::Base64),
            commitment: Some(CommitmentConfig::confirmed()),
            ..Default::default()
        };
        
        let response = match rpc_client
            .get_multiple_accounts_with_config(&addresses, config)
            .await
        {
            Ok(response) => response,
            Err(e) => {
                warn!("Retry RPC batch fetch failed: {}", e);
                stats.pools_rpc_error += addresses.len();
                continue;
            }
        };
        
        let batch_slot = response.context.slot;
        stats.rpc_slot_min = Some(stats.rpc_slot_min.map_or(batch_slot, |min| min.min(batch_slot)));
        stats.rpc_slot_max = Some(stats.rpc_slot_max.map_or(batch_slot, |max| max.max(batch_slot)));
        
        if batch_slot < MIN_VALID_SLOT {
            stats.pools_rpc_error += addresses.len();
            continue;
        }
        
        for (i, maybe_account) in response.value.into_iter().enumerate() {
            let address = addresses[i];
            let dex = dex_types[i];
            
            let Some(account) = maybe_account else {
                stats.pools_no_data += 1;
                continue;
            };
            
            let data = &account.data;
            
            let parsed = match dex {
                DexType::RaydiumClmm | DexType::PancakeSwapClmm => {
                    parse_raydium_clmm(address, data).map(ParsedClmmState::from)
                }
                DexType::MeteoraDamm => {
                    parse_meteora_damm(address, data).map(ParsedClmmState::from)
                }
                DexType::OrcaWhirlpool => {
                    parse_whirlpool_state(address, data, &mut stats)
                }
                DexType::MeteoraDlmm => {
                    parse_dlmm_state(address, data, &mut stats)
                }
                _ => None,
            };
            
            let Some(pool_data) = parsed else {
                stats.pools_failed_parse += 1;
                continue;
            };
            
            let updated = psm.update_clmm_state_from_bootstrap(
                &address,
                pool_data.sqrt_price,
                pool_data.current_tick_or_bin,
                pool_data.spacing,
                pool_data.active_liquidity,
                batch_slot,
            );
            
            if updated {
                stats.pools_updated += 1;
                debug!(pool = %address, "Retry bootstrap succeeded");
            } else {
                stats.pools_skipped_geyser_confirmed += 1;
            }
        }
    }
    
    stats.duration_ms = start.elapsed().as_millis() as u64;
    stats.completed = true;
    
    Ok(stats)
}

/// Intermediate parsed state for CLMM pools
struct ParsedClmmState {
    sqrt_price: Option<u128>,
    active_liquidity: Option<u128>,
    current_tick_or_bin: i32,
    spacing: u16,
}

/// Wrapper around pool_discovery's DiscoveredPool to extract just the fields we need
impl From<crate::pool_discovery::DiscoveredPool> for ParsedClmmState {
    fn from(p: crate::pool_discovery::DiscoveredPool) -> Self {
        Self {
            sqrt_price: p.sqrt_price,
            active_liquidity: p.active_liquidity,
            current_tick_or_bin: p.current_tick_or_bin,
            spacing: p.spacing,
        }
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_batch_size() {
        // Ensure we don't exceed RPC limits
        assert!(BATCH_SIZE <= 100);
    }
}
